[Unit]
Description=Omega Panel V4 Stable Web Panel
After=network-online.target incus.service
Wants=network-online.target

[Service]
Type=simple
User=omega-panel
Group=omega-panel
WorkingDirectory=/opt/omega-panel
Environment=PYTHONPATH=/opt/omega-panel
EnvironmentFile=-/etc/omega-panel/omega.env
ExecStart=/opt/omega-panel/venv/bin/gunicorn --workers 2 --threads 2 --timeout 120 --bind 0.0.0.0:5000 app:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/omega-panel /etc/omega-panel

[Install]
WantedBy=multi-user.target
