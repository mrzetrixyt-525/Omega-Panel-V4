# Omega Panel V4 Stable configuration
OMEGA_HOSTNAME=rgnodes-vps
OMEGA_BIND=0.0.0.0
OMEGA_PORT=5000
OMEGA_SECRET_FILE=/etc/omega-panel/secret
OMEGA_DB=/var/lib/omega-panel/omega.db
OMEGA_DATA_DIR=/var/lib/omega-panel
OMEGA_VPS_ENGINE=incus
OMEGA_DEFAULT_VCPUS=2
OMEGA_DEFAULT_MEMORY_MB=8192
OMEGA_DEFAULT_DISK_GB=25
OMEGA_MAX_VPS_PER_USER=1
OMEGA_AUTO_UPDATE=true
OMEGA_TIMEZONE=Asia/Dhaka
OMEGA_NODE_TOKEN_FILE=/etc/omega-panel/node-token
# Optional node API listener
OMEGA_NODE_BIND=127.0.0.1
OMEGA_NODE_PORT=5001
OMEGA_NODE_NAME=rgnodes-vps
# Set this to a trusted public URL if using remote-node callbacks.
OMEGA_PANEL_URL=http://127.0.0.1:5000
